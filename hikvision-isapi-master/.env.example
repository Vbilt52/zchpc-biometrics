# ZCHPC Access Control Suite — Configuration

# ============================================================
#  Zimbabwe Centre for High Performance Computing (ZCHPC)
#  https://hpc.ac.zw | Accelerating innovation through Supercomputing
# ============================================================

# Default device to use (must match a key in config/zchpc.php devices array)
ZCHPC_DEFAULT_DEVICE=primary

# ---------------------------------------------------------------
# Primary Device Connection Settings
# ---------------------------------------------------------------
ZCHPC_DEVICE_IP=192.168.1.100
ZCHPC_DEVICE_PORT=80
ZCHPC_DEVICE_PROTOCOL=http

# Authentication
ZCHPC_DEVICE_USERNAME=admin
ZCHPC_DEVICE_PASSWORD=your_device_password_here

# Connection Settings
ZCHPC_DEVICE_TIMEOUT=30
ZCHPC_DEVICE_VERIFY_SSL=false

# Response Format (json or xml)
ZCHPC_DEVICE_FORMAT=json

# ---------------------------------------------------------------
# Logging
# ---------------------------------------------------------------
ZCHPC_LOGGING=true
ZCHPC_LOG_CHANNEL=stack
