[Unit]
Description=ZCHPC queue worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=user
Group=www-data
WorkingDirectory=/var/www/zchpc-biometrics/zchpc-dashboard
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --timeout=900 --max-time=3600
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=960
UMask=0002

[Install]
WantedBy=multi-user.target
