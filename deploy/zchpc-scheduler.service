[Unit]
Description=ZCHPC scheduler
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=user
Group=www-data
WorkingDirectory=/var/www/zchpc-biometrics/zchpc-dashboard
ExecStart=/usr/bin/php artisan schedule:work
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=180
UMask=0002

[Install]
WantedBy=multi-user.target
